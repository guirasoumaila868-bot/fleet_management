<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_document_tree" model="ir.ui.view">
        <field name="name">smart.fleet.document.tree</field>
        <field name="model">smart.fleet.document</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="vehicle_id" column_invisible="context.get('default_vehicle_id')"/>
                <field name="type_document"/>
                <field name="reference"/>
                <field name="date_emission"/>
                <field name="date_expiration"/>
                <field name="statut" widget="badge"
                       decoration-success="statut == 'valide'"
                       decoration-warning="statut == 'expire_bientot'"
                       decoration-danger="statut == 'expire'"
                       decoration-muted="statut == 'indetermine'"/>
            </tree>
        </field>
    </record>

    <record id="action_fleet_document_all" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">smart.fleet.document</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
