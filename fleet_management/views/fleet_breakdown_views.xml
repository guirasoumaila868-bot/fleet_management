<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_breakdown_tree" model="ir.ui.view">
        <field name="name">smart.fleet.breakdown.tree</field>
        <field name="model">smart.fleet.breakdown</field>
        <field name="arch" type="xml">
            <tree decoration-danger="gravite == 'grave'">
                <field name="vehicle_id"/>
                <field name="name"/>
                <field name="date"/>
                <field name="gravite" widget="badge"/>
                <field name="cout_reparation"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fleet_breakdown_form" model="ir.ui.view">
        <field name="name">smart.fleet.breakdown.form</field>
        <field name="model">smart.fleet.breakdown</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="date"/>
                            <field name="gravite"/>
                        </group>
                        <group>
                            <field name="cout_reparation"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description de la panne..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fleet_breakdown_search" model="ir.ui.view">
        <field name="name">smart.fleet.breakdown.search</field>
        <field name="model">smart.fleet.breakdown</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_fleet_breakdown" model="ir.actions.act_window">
        <field name="name">Pannes et réparations</field>
        <field name="res_model">smart.fleet.breakdown</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fleet_breakdown_search"/>
    </record>
</odoo>
