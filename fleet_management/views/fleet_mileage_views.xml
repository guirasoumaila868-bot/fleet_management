<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_mileage_tree" model="ir.ui.view">
        <field name="name">smart.fleet.mileage.tree</field>
        <field name="model">smart.fleet.mileage</field>
        <field name="arch" type="xml">
            <tree create="true">
                <field name="date"/>
                <field name="compteur"/>
                <field name="source" widget="badge"/>
                <field name="operateur"/>
            </tree>
        </field>
    </record>
</odoo>
