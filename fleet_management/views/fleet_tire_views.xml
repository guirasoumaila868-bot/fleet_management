<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_tire_tree" model="ir.ui.view">
        <field name="name">smart.fleet.tire.tree</field>
        <field name="model">smart.fleet.tire</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="position"/>
                <field name="marque"/>
                <field name="dimension"/>
                <field name="numero_serie"/>
                <field name="etat" widget="badge" decoration-success="etat == 'bon'" decoration-warning="etat == 'use'" decoration-danger="etat == 'a_remplacer'"/>
            </tree>
        </field>
    </record>
</odoo>
