<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_maintenance_tree" model="ir.ui.view">
        <field name="name">smart.fleet.maintenance.tree</field>
        <field name="model">smart.fleet.maintenance</field>
        <field name="arch" type="xml">
            <tree>
                <field name="vehicle_id"/>
                <field name="name"/>
                <field name="date_planifiee"/>
                <field name="kilometrage_prevu"/>
                <field name="cout"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_fleet_maintenance_form" model="ir.ui.view">
        <field name="name">smart.fleet.maintenance.form</field>
        <field name="model">smart.fleet.maintenance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="vehicle_id"/>
                        <field name="date_planifiee"/>
                        <field name="kilometrage_prevu"/>
                        <field name="cout"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fleet_maintenance_search" model="ir.ui.view">
        <field name="name">smart.fleet.maintenance.search</field>
        <field name="model">smart.fleet.maintenance</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_fleet_maintenance" model="ir.actions.act_window">
        <field name="name">Entretien préventif</field>
        <field name="res_model">smart.fleet.maintenance</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fleet_maintenance_search"/>
    </record>
</odoo>
